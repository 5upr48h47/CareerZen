# CareerZen Server Environment Variables
# Copy to .env and fill in. Never commit a real .env.

PORT=5009
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Local dev uses SQLite:
DATABASE_URL=file:./careerzen.db
DB_PROVIDER=sqlite

# Production uses PostgreSQL (Neon / Render both have free tiers):
# DATABASE_URL=postgresql://user:password@host:5432/careerzen?sslmode=require
# DB_PROVIDER=postgresql

# ── Security ────────────────────────────────────────────────────────────────
# REQUIRED, minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every existing login session.
JWT_SECRET=replace-with-a-random-64-character-string

# ── URLs ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Must match the real domain
# in production or the browser will block API calls.
CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

LOG_LEVEL=info

# ── Payments (Razorpay) ─────────────────────────────────────────────────────
# rzp_test_* is sandbox only — real payments need rzp_live_* keys from
# https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# ── AI (Google Gemini) ──────────────────────────────────────────────────────
# Without this the AI features fall back to local heuristics instead of
# real LLM inference. Free tier available.
# GEMINI_API_KEY=AIza...

# ── SMS (Twilio) ────────────────────────────────────────────────────────────
# Unset means OTPs are logged to the terminal — never acceptable in production.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=VA...
# SMS_MODE=twilio

# ── File storage ────────────────────────────────────────────────────────────
# Local disk is ephemeral on most hosts. Point uploads at Cloudinary or
# Cloudflare R2 for production (both have free tiers).
# STORAGE_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...

# ── Seeding ─────────────────────────────────────────────────────────────────
# Demo accounts use password123 and include a recruiter who can post jobs.
# Never enable on a public deployment — the server skips them in production
# unless this is explicitly "true".
SEED_DEMO=false

# ── Observability ───────────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ── Admin SSO (OIDC) ────────────────────────────────────────────────────────
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_REDIRECT_URI=https://yourdomain.com/api/auth/admin-sso/callback
# OIDC_ADMIN_EMAILS=you@example.com

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20